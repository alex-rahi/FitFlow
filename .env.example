# Supabase — replace with real values from your Supabase project dashboard
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key-replace-me
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-replace-me
SUPABASE_JWT_SECRET=placeholder-jwt-secret-for-local-dev-only

# Database (direct connection for backend/workers)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
USE_PLACEHOLDERS=true
USE_LOCAL_YOLO=false
WORKER_URL=http://localhost:8001
UPLOADS_DIR=data/uploads

# Storage buckets
STORAGE_BUCKET_RAW=raw-uploads
STORAGE_BUCKET_PROCESSED=processed-videos
STORAGE_BUCKET_THUMBNAILS=thumbnails

# AI Worker
WORKER_POLL_INTERVAL=5
FRAME_EXTRACT_INTERVAL=2
YOLO_MODEL_PATH=workers/models/yolov8n.pt
MODERATION_THRESHOLD=0.7

# Admin
ADMIN_SECRET=placeholder-admin-secret

# Mobile (also set in apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-replace-me
EXPO_PUBLIC_USE_PLACEHOLDERS=true
EXPO_PUBLIC_USE_LOCAL_YOLO=false

# Admin dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
